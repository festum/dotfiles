{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    {
      "package": "opencode-rules@latest",
      "options": {
        "additionalRuleDirectories": [],
      },
    },
  ],
  "autoupdate": true,
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest",
        "--api-key",
        "{file:~/.config/opencode/.opencode-secrets}"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    }
  },
  "permission": {
    "*": "allow",
    "bash": "allow",
    "write": "allow",
    "list": "allow",
    "edit": "allow",
    "patch": "allow",
    "grep": "allow",
    "glob": "allow",
    "tools": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": {
      "*": "allow",
      "golang-*": "deny",
      "go-reviewer": "deny"
    },
    "lsp": "allow"
  },
  "provider": {},
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "command": {
    "test": {
      "template": "Run the full test suite with coverage report and show any failures.\nFocus on the failing tests and fix them.",
      "description": "Run tests with coverage",
      "agent": "build"
    }
  },
  "disabled_providers": [
  ]
}
