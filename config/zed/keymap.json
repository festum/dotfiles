[
  {
    "context": "Editor",
    "bindings": {
      "shift-alt-u": "editor::UniqueLinesCaseInsensitive",
      "cmd-shift-r": "editor::ReloadFile",
      "cmd-h": "buffer_search::DeployReplace",
      "cmd-g": "go_to_line::Toggle",
      "cmd-b cmd-s": "multi_workspace::ToggleWorkspaceSidebar",
      "cmd-b cmd-a": "workspace::ToggleRightDock",
      "cmd-b cmd-n": "workspace::ToggleBottomDock",
      "ctrl-b ctrl-s": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-b ctrl-a": "workspace::ToggleRightDock",
      "ctrl-b ctrl-n": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle",
      "cmd-`": "workspace::ToggleBottomDock",
      "cmd-b cmd-b": "workspace::ToggleBottomDock",
      "cmd-b cmd-s": "multi_workspace::ToggleWorkspaceSidebar",
      "cmd-b cmd-a": "workspace::ToggleRightDock",
      "ctrl-`": "workspace::ToggleBottomDock",
      "ctrl-b ctrl-b": "workspace::ToggleBottomDock",
      "ctrl-b ctrl-s": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-b ctrl-a": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "f3": "search::SelectNextMatch",
      "shift-f3": "search::SelectPreviousMatch",
    },
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "f3": "search::SelectNextMatch",
      "shift-f3": "search::SelectPreviousMatch",
    },
  }
]
