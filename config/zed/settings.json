{
  "context_servers": {
    "Context7": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        // Set CONTEXT7_API_KEY in envvar
      },
    },
    "Sequential-Thinking": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {},
    },
    "Hindsight": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": ["-y", "hindsight-mcp"],
      "env": {
        "MEMORY_SERVICE_BASE_URL": "http://s0.bombay-city.ts.net:8888/mcp/zed",
      },
    },
    "mcp-server-memory": {
      "enabled": true,
      "remote": false,
      "settings": {
        "memory_file_path": "/Users/fqin/Dropbox/LLM/memory/my-knowledge-graph.jsonl",
      },
    },
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "support.google.com",
        "www.coinbase.com"
      ],
      "allow_fs_write_all": true,
      "allow_network_all": true,
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "claude-haiku-4.5",
        "enable_thinking": true
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.6",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.7",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
    "use_modifier_to_send": false,
  },
  "agent_servers": {
    "qwen-code": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "agoragentic-acp": {
      "type": "registry",
    },
    "codex-acp-custom": {
      "type": "custom",
      "command": "zedcode-acp-codex",
    },
  },
  "auto_signature_help": true,
  "autosave": "on_window_change",
  "base_keymap": "VSCode",
  "buffer_font_fallbacks": [],
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 13,
  "current_line_highlight": "all",
  "diagnostics_max_severity": "error",
  "edit_predictions_disabled_in": ["comment", "string"],
  "formatter": "auto",
  "hide_mouse": "on_typing",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "scroll_beyond_last_line": "one_page",
  "soft_wrap": "editor_width",
  "theme": "Warm Perf",
  "ui_font_size": 14,
  "use_autoclose": false,
  "centered_layout": {
    "left_padding": 0,
    "right_padding": 0,
  },
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 0.5,
  },
  "minimap": {
    "show": "auto",
    "thumb": "always",
    "thumb_border": "left_open",
    "current_line_highlight": "all",
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "left_neighbour",
    "show_close_button": "hover",
    "show_diagnostics": "errors",
  },
  "inlay_hints": {
    "enabled": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
  },
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": [
      "**/.env*",
      "**/.dev*",
      "**/*.pem",
      "**/*.key",
      "**/*.cert",
      "**/*.crt",
      "**/secrets.yml",
    ],
  },
  "session": {
    "restore_unsaved_buffers": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
